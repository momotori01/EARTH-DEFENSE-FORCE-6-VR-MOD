#pragma once
// Generated by CMake from EDF6MultiSlot.ini; written next to the plugin when no INI exists.
// Two literals, joined by the compiler (one may hold at most 16380 bytes).
inline constexpr const char kDefaultIni[] = R"MULTISLOT_INI(@MULTISLOT_DEFAULT_INI_1@)MULTISLOT_INI"
                                            R"MULTISLOT_INI(@MULTISLOT_DEFAULT_INI_2@)MULTISLOT_INI";
