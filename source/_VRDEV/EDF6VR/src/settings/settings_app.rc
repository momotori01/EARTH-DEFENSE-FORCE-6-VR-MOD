#include <winres.h>

1 ICON "../../assets/settings/vr.ico"
1 RT_MANIFEST "settings_app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION EDF6VR_VERSION_COMMA
PRODUCTVERSION EDF6VR_VERSION_COMMA
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "EDF6 VR setting"
            VALUE "FileVersion", EDF6VR_VERSION_TEXT
            VALUE "ProductName", "EDF6VR"
            VALUE "ProductVersion", EDF6VR_VERSION_TEXT
            VALUE "OriginalFilename", "EDF6 VR setting.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
